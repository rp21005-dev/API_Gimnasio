                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"entrenadorId\", pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
