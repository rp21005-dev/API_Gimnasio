    {
      "name": "6. Permisos por rol",
      "description": "El miembro de demostración consulta el catálogo y se inscribe a sí mismo, pero no puede gestionar usuarios ni catálogos (403).",
      "item": [
        {
          "name": "Iniciar sesión como miembro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"miembro@gimnasio.com\",\n  \"contrasena\": \"clave1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenMiembro\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Miembro consulta las clases (200)",
          "request": {
            "method": "GET",
            "header": [],
