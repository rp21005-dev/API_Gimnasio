{
  "info": {
    "name": "API_Gimnasio - Presentación",
    "description": "Recorrido de la presentación. Ejecutar las carpetas en orden.\nLa carpeta 1 guarda el token y todas las demás peticiones lo usan automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/gimnasioAPI"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "claseId",
      "value": ""
    },
    {
      "key": "claseInscripcionId",
      "value": ""
    },
    {
      "key": "miembroId",
      "value": ""
    },
    {
      "key": "inscripcionId",
      "value": ""
    },
    {
      "key": "asistenciaId",
      "value": ""
    },
    {
      "key": "fechaHoy",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "salaId",
      "value": ""
    },
    {
      "key": "entrenadorId",
      "value": ""
    },
    {
      "key": "miembroRegistradoId",
      "value": ""
    },
    {
      "key": "entrenadorRegistradoId",
      "value": ""
    },
    {
      "key": "tokenMiembro",
      "value": ""
    },
    {
      "key": "claseParaMiembroId",
      "value": ""
    },
    {
      "key": "inscripcionMiembroId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Seguridad (JWT)",
      "item": [
        {
          "name": "Listar clases SIN token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases",
            "auth": {
              "type": "noauth"
            },
            "description": "Sin token la API rechaza la petición."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gimnasio.com\",\n  \"contrasena\": \"incorrecta1\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gimnasio.com\",\n  \"contrasena\": \"clave1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "pm.collectionVariables.set(\"fechaHoy\", new Date().toLocaleDateString(\"en-CA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar clases CON token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. CRUD de clases",
      "item": [
        {
          "name": "Buscar la categoría de Yoga",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const categoria = pm.response.json().find(c => c.tiposClase.includes(\"Yoga (Hatha, Vinyasa)\"));",
                  "pm.collectionVariables.set(\"categoriaId\", categoria.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar la sala Mente y Cuerpo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/salas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const salas = pm.response.json();",
                  "pm.collectionVariables.set(\"salaId\", (salas.find(s => s.nombre.includes(\"Mente\")) || salas[0]).id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar entrenadores (guarda el primero)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/entrenador"
