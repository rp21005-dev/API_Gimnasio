              }
            ],
            "url": "{{baseUrl}}/entrenador",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Laura\",\n  \"apellidos\": \"Gómez\",\n  \"correo\": \"laura{{$timestamp}}@ejemplo.com\",\n  \"telefono\": \"7000-5555\",\n  \"especialidad\": \"Crossfit\",\n  \"contrasenaHash\": \"clave1234\"\n}"
            }
          },
          "event": [
            {
