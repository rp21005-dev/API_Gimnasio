# Copiar este archivo como .env y completar los valores locales.
# Docker Compose sobrescribe DB_URL con el nombre del servicio "postgres";
# este valor se usa solo cuando ejecutas la aplicacion fuera de Docker.

DB_URL=jdbc:postgresql://localhost:5432/gimnasio
DB_USER=postgres
DB_PASSWORD=postgres

# Clave para firmar los JWT (minimo 32 caracteres). Generar con: openssl rand -base64 48
JWT_SECRET=

# Puerto del servidor (por defecto 8080; las plataformas de despliegue lo asignan con PORT)
# PORT=8080

# Crear los usuarios de demostración (clave1234) al iniciar. Poner false en producción.
DATOS_DEMO=true
