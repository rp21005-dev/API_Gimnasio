{
  "info": {
    "name": "API_Gimnasio - Presentación",
    "description": "Recorrido de la presentación. Ejecutar las carpetas en orden.\nLa carpeta 1 guarda el token y todas las demás peticiones lo usan automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/gimnasioAPI"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "claseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Seguridad (JWT)",
      "item": [
        {
          "name": "Listar clases SIN token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases",
            "auth": {
              "type": "noauth"
            },
            "description": "Sin token la API rechaza la petición."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gimnasio.com\",\n  \"contrasena\": \"incorrecta1\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gimnasio.com\",\n  \"contrasena\": \"clave1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar clases CON token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. CRUD de clases",
      "item": [
        {
          "name": "Crear clase (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoClase\": \"Yoga\",\n  \"diasSemana\": [\n    \"Martes\",\n    \"Jueves\"\n  ],\n  \"horaInicio\": \"18:00:00\",\n  \"horaFin\": \"19:00:00\",\n  \"fechaInicio\": \"2026-11-03\",\n  \"cupoMaximo\": 15,\n  \"descripcion\": \"Clase de relajación y flexibilidad.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"claseId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener clase por ID (200, ver caché en logs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases/{{claseId}}",
            "description": "Ejecutar dos veces: la consulta SQL solo aparece en los logs la primera vez."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar clase (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clases/{{claseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoClase\": \"Yoga\",\n  \"diasSemana\": [\n    \"Martes\",\n    \"Jueves\"\n  ],\n  \"horaInicio\": \"18:00:00\",\n  \"horaFin\": \"19:00:00\",\n  \"fechaInicio\": \"2026-11-03\",\n  \"cupoMaximo\": 25,\n  \"descripcion\": \"Clase de relajación y flexibilidad.\",\n  \"estado\": \"CERRADA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar clase (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/clases/{{claseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener clase eliminada (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clases/{{claseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear clase con datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoClase\": \"\",\n  \"diasSemana\": [],\n  \"cupoMaximo\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Miembros",
      "item": [
        {
          "name": "Registrar miembro sin token (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/miembros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"López\",\n  \"documentoIdentidad\": \"DUI-{{$timestamp}}\",\n  \"correo\": \"ana{{$timestamp}}@ejemplo.com\",\n  \"telefono\": \"7000-1234\",\n  \"fechaNacimiento\": \"2001-03-10\",\n  \"contrasenaHash\": \"clave1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Endpoint público: cualquiera puede registrarse."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar miembro con correo repetido (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/miembros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"López\",\n  \"documentoIdentidad\": \"DUI-{{$timestamp}}\",\n  \"correo\": \"miembro@gimnasio.com\",\n  \"telefono\": \"7000-1234\",\n  \"fechaNacimiento\": \"2001-03-10\",\n  \"contrasenaHash\": \"clave1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar miembros (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/miembros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
